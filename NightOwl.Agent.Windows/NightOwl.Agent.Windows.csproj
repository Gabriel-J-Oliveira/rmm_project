<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NightOwl.Agent.Windows</AssemblyName>
    <RootNamespace>NightOwl.Agent.Windows</RootNamespace>
    <ApplicationIcon>..\assets\icons\NightOwl.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="agent.config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="..\assets\icons\NightOwl.ico" Link="assets\icons\NightOwl.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="scripts\Install-NightOwlAgentDotNet.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" TargetPath="Install-NightOwlAgentDotNet.ps1" />
    <None Include="scripts\Uninstall-NightOwlAgentDotNet.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" TargetPath="Uninstall-NightOwlAgentDotNet.ps1" />
    <None Include="scripts\Publish-NightOwlAgentDownload.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" TargetPath="Publish-NightOwlAgentDownload.ps1" />
  </ItemGroup>
</Project>
