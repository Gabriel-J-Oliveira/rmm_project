<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NightOwl.Agent.Diagnostics</AssemblyName>
    <RootNamespace>NightOwl.Agent.Diagnostics</RootNamespace>
    <Version>0.1.0.7</Version>
    <AssemblyVersion>0.1.0.7</AssemblyVersion>
    <FileVersion>0.1.0.7</FileVersion>
    <InformationalVersion>0.1.0.7</InformationalVersion>
    <ApplicationIcon>..\assets\icons\NightOwl.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NightOwl.Agent.Shared\NightOwl.Agent.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\assets\icons\NightOwl.ico" Link="assets\icons\NightOwl.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
