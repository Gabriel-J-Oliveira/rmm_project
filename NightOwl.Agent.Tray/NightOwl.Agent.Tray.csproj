<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NightOwl.Agent.Tray</AssemblyName>
    <RootNamespace>NightOwl.Agent.Tray</RootNamespace>
    <ApplicationIcon>assets\icons\NightOwl.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\icons\NightOwl.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <EmbeddedResource Include="assets\icons\NightOwl.ico" LogicalName="NightOwl.ico" />
  </ItemGroup>
</Project>
